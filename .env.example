# Copia este archivo como .env.local y completa los datos que entrega TI.
# Si lo dejas vacío, el portal funciona en modo demostración (login simulado).

# Id de la aplicación (cliente) registrada en Microsoft Entra ID
VITE_ENTRA_CLIENT_ID=
# Id del directorio (tenant) de UC CHRISTUS
VITE_ENTRA_TENANT_ID=
# Correos que entran siempre como administrador, separados por coma
VITE_ADMINISTRADORES=
